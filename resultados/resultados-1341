import pandas as pd
from pathlib import Path

# 1. Datos de las bibliotecas
datos_bibliotecas = {
    "Biblioteca": [
        "Vasconcelos", "México", "Lerdo",
        "Bellas Artes", "Central", "Infantil"
    ],
    "Libros": [600000, 450000, 280000, 150000, 320000, 50000],
    "Usuarios_dia": [3500, 2800, 1500, 1200, 2200, 800]
}

# 2. Crear la tabla de datos
df = pd.DataFrame(datos_bibliotecas)

# 3. Crear la carpeta de resultados
carpeta = Path("resultados")
carpeta.mkdir(parents=True, exist_ok=True)

# 4. Guardar los datos en un archivo CSV
archivo = carpeta / "bibliotecas_1341.csv"
df.to_csv(archivo, index=False, encoding="utf-8-sig")

# 5. Mostrar los datos
print(df)

# 6. Confirmar dónde se guardó el archivo
print("\nNúmero de control: 1341")
print("Archivo guardado en:", archivo.resolve())
print("valeria NC = 1341")